# Copy to deployment.env (ignored by Git), or export these settings explicitly.
# Use a NEW run ID and matching scoped IAM policy for a new experiment.
export AWS_PROFILE="${AWS_PROFILE:-default}"
: "${RUN_ID:?Set a stable unique RUN_ID for this study}"
: "${S3_BUCKET:?Set your existing S3 bucket}"
: "${INSTANCE_PROFILE:?Set an EC2 instance profile with scoped S3 and SSM access}"
export RUN_ID S3_BUCKET INSTANCE_PROFILE
# Optional: export S3_REGION to the BUCKET region; otherwise it is discovered.
export FR_INSTANCE_TYPE="${FR_INSTANCE_TYPE:-g6.2xlarge}"
export IE_INSTANCE_TYPE="${IE_INSTANCE_TYPE:-g4dn.2xlarge}"
export MODE="${MODE:-on-demand}"
export STAGE="${STAGE:-development}"
export WORKERS="${WORKERS:-3}"
export MAX_HOURS="${MAX_HOURS:-24}"
