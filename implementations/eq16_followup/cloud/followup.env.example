# Copy to ignored followup.env or export your own values explicitly.
# RUN_ID identifies the ORIGINAL parent study; FOLLOWUP_ID is a fresh extension.
export AWS_PROFILE="${AWS_PROFILE:-default}"
: "${RUN_ID:?Set the original study RUN_ID}"
: "${FOLLOWUP_ID:?Set a new stable FOLLOWUP_ID}"
: "${S3_BUCKET:?Set the existing study bucket}"
: "${INSTANCE_PROFILE:?Set a role profile with scoped parent-read/followup-write access}"
export RUN_ID FOLLOWUP_ID S3_BUCKET INSTANCE_PROFILE
# S3_REGION is the bucket region, not the compute region; discovery is supported.
export FR_INSTANCE_TYPE="${FR_INSTANCE_TYPE:-g6.2xlarge}"
export IE_INSTANCE_TYPE="${IE_INSTANCE_TYPE:-g4dn.2xlarge}"
export MODE="${MODE:-on-demand}"
export STAGE="${STAGE:-audit}"
export FAMILY="${FAMILY:-actuation}"
export WORKERS="${WORKERS:-3}"
export MAX_HOURS="${MAX_HOURS:-2}"
export BRIDGE_ALL="${BRIDGE_ALL:-0}"
