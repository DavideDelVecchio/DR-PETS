{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LocateStudyBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET"
    },
    {
      "Sid": "ReadFrozenDevelopmentInputs",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::REPLACE_BUCKET/drpets-eight/REPLACE_RUN_ID/frankfurt/results/development_seed_*/*",
        "arn:aws:s3:::REPLACE_BUCKET/drpets-eight/REPLACE_RUN_ID/ireland/results/development_seed_*/*"
      ]
    },
    {
      "Sid": "ReadWriteOnlyThisFollowup",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/drpets-eight/REPLACE_RUN_ID/followup/REPLACE_FOLLOWUP_ID/*"
    },
    {
      "Sid": "ListRequiredPrefixes",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "drpets-eight/REPLACE_RUN_ID/frankfurt/results/*",
            "drpets-eight/REPLACE_RUN_ID/ireland/results/*",
            "drpets-eight/REPLACE_RUN_ID/followup/REPLACE_FOLLOWUP_ID/*"
          ]
        }
      }
    }
  ]
}
